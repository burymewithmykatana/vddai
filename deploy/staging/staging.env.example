# Copy outside the repository (for example, /etc/vddai/staging.env), set real
# values there, restrict the file to the deployment operator, and do not commit it.
# Values are unquoted printable ASCII literals: no whitespace, quotes, $, #,
# or backslashes. Do not use interpolation, inline comments, or duplicate keys.
# Only settings listed in this template are supported (no libpq PG* overrides).
# POSTGRES_USER/POSTGRES_DB are ASCII identifiers (letters/digits/underscore,
# not starting with a digit). POSTGRES_PASSWORD accepts ASCII letters/digits
# and -._~ only; choose a long random value. Use that exact password in
# DATABASE_URL (no percent encoding); use postgres:5432, no URL options.
ENVIRONMENT=staging
PROJECT_NAME=vddai-backend

POSTGRES_USER=replace-staging-postgres-user
POSTGRES_PASSWORD=replace-staging-postgres-password
POSTGRES_DB=replace-staging-postgres-db
DATABASE_URL=postgresql+psycopg://replace-staging-postgres-user:replace-staging-postgres-password@postgres:5432/replace-staging-postgres-db
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=replace-with-a-unique-high-entropy-staging-secret
JWT_EXPIRE_MINUTES=60

MAX_IMAGE_SIZE_MB=5
MAX_IMAGE_PIXELS=16777216
IMAGE_STORAGE_BACKEND=local
IMAGE_STORAGE_ROOT=uploads
PREDICTION_RATE_LIMIT_REQUESTS=10
PREDICTION_RATE_LIMIT_WINDOW_SECONDS=60
PREDICTION_USER_OUTSTANDING_LIMIT=5
PREDICTION_GLOBAL_OUTSTANDING_LIMIT=50
PREDICTION_CAPACITY_RETRY_AFTER_SECONDS=5

MODEL_IMAGE_WIDTH=224
MODEL_IMAGE_HEIGHT=224
MODEL_DEVICE=cpu
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_DELAY_SECONDS=5.0
WORKER_ATTEMPT_LEASE_SECONDS=300.0
MODEL_REGISTRY_PATH=artifacts/registry/model_registry.sqlite3
MODEL_ARTIFACT_ROOT=.
